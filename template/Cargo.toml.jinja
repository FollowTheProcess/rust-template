[package]
name = "{{project_slug}}"
version = "0.1.0"
edition = "2024"
description = "{{description}}"
readme = "README.md"
homepage = "{{github_url}}"
repository = "{{github_url}}"
license = "{{license}}"
keywords = [ "keywords", "here" ]
categories = [ "command-line-utilities" ]

# TODO: Remove when ready
publish = false

{% if project_type == 'binary' -%}
[[bin]]
name = "{{binary_name}}"
path = "src/main.rs"
{%- endif %}

[dependencies]

[lints.clippy]
pedantic = { level = "warn", priority = -1 }
nursery = { level = "warn", priority = -1 }

# Prevent panics
arithmetic_side_effects = "deny"
as_conversions = "deny"
exit = "deny"
expect_used = "deny"
indexing_slicing = "deny"
panic = "deny"
panic_in_result_fn = "deny"
string_slice = "deny"
unchecked_time_subtraction = "deny"
unimplemented = "deny"
unreachable = "deny"
unwrap_used = "deny"

[lints.rust]
missing_docs = "warn"
unsafe_code = "forbid"
unused_must_use = "deny"
